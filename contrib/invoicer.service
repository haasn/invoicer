# Install: cp contrib/invoicer.service ~/.config/systemd/user/
#          systemctl --user enable --now invoicer
# Assumes the repository in ~/dev/invoicer and data_dir set in
# ~/.config/invoicer/config.json.
[Unit]
Description=invoicer web UI on http://127.0.0.1:8765/

[Service]
ExecStart=/usr/bin/python3 %h/dev/invoicer/bin/invoicer serve --port 8765 --no-browser --token-file %t/invoicer/token
# Survives restarts, so open tabs keep their token; cleared on logout.
RuntimeDirectory=invoicer
RuntimeDirectoryPreserve=yes
Environment=PYTHONUNBUFFERED=1
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
